{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BitsByBlocks Lesson Schema",
  "description": "Schema for a lesson.json file in the BitsByBlocks AI Engineering Notebook course.",
  "type": "object",
  "required": [
    "id",
    "level",
    "level_name",
    "title",
    "published_at",
    "question",
    "can",
    "one_line",
    "story_spine",
    "sections",
    "figures",
    "jargon_decoder",
    "lab",
    "shareable"
  ],
  "properties": {
    "id": { "type": "string", "description": "Unique module ID matching curriculum.json (e.g., l0-what-is-an-llm)" },
    "level": { "type": "integer", "minimum": 0, "maximum": 5 },
    "level_name": { "type": "string" },
    "title": { "type": "string" },
    "published_at": { "type": "string" },
    "read_time_minutes": { "type": "integer" },
    "question": { "type": "string" },
    "can": { "type": "string" },
    "one_line": { "type": "string" },
    "story_spine": {
      "type": "object",
      "required": ["surprise", "broken", "question", "turn", "payoff", "honest_limit"],
      "properties": {
        "surprise": { "type": "string" },
        "broken": { "type": "string" },
        "question": { "type": "string" },
        "turn": { "type": "string" },
        "payoff": { "type": "string" },
        "honest_limit": { "type": "string" }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "layout", "caption"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "layout": { "type": "string", "enum": ["flow", "stack", "grid", "tree"] },
          "caption": { "type": "string" },
          "nodes": { "type": "array" },
          "edges": { "type": "array" },
          "callouts": { "type": "array" },
          "cells": { "type": "array" },
          "levels": { "type": "array" }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "body_md"],
        "properties": {
          "heading": { "type": "string" },
          "badge": { "type": "string" },
          "body_md": { "type": "string" },
          "figure_id": { "type": "string" }
        }
      }
    },
    "jargon_decoder": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "plain_words", "why_you_care"],
        "properties": {
          "term": { "type": "string" },
          "plain_words": { "type": "string" },
          "why_you_care": { "type": "string" }
        }
      }
    },
    "lab": {
      "type": "object",
      "required": ["title", "goal", "steps", "acceptance", "code_file", "walkthrough_md", "real_output"],
      "properties": {
        "title": { "type": "string" },
        "goal": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["criterion", "met", "evidence"],
            "properties": {
              "criterion": { "type": "string" },
              "met": { "type": "boolean" },
              "evidence": { "type": "string" }
            }
          }
        },
        "code_file": { "type": "string" },
        "walkthrough_md": { "type": "string" },
        "real_output": { "type": "string" }
      }
    },
    "shareable": {
      "type": "object",
      "required": ["notebook_shelf", "the_turn", "x_thread", "instagram_carousel", "reel_hook"],
      "properties": {
        "notebook_shelf": { "type": "string" },
        "the_turn": { "type": "string" },
        "x_thread": { "type": "array", "items": { "type": "string" } },
        "instagram_carousel": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slide", "headline", "body"],
            "properties": {
              "slide": { "type": "integer" },
              "headline": { "type": "string" },
              "body": { "type": "string" }
            }
          }
        },
        "reel_hook": { "type": "string" }
      }
    }
  }
}
